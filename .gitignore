# Append these to your project's .gitignore. Safe to add even if some
# are already present — duplicates are ignored.

# Claude Code tooling: settings, skills, and session transcripts.
# Kept on disk for local development; never published.
.claude/

# Local Claude project instructions (personal/environment context).
# Stays on disk so sessions still load it; not committed.
CLAUDE.md
CLAUDE.local.md

# Legacy migration archive (session notes, old plans) — not published.
old/

# Credentials and sensitive files (defensive).
**/*api*key*
**/*.env

# Python
__pycache__/
*.pyc

# .NET build artifacts
[Bb]in/
[Oo]bj/

# JS test dependencies (tests/js)
node_modules/

# Publish output (build artifact)
publish/

# Per-bucket MCP config (kept local — public repo).
.mcp.json

# Legacy root-level session notes.
notes.md

# Working record: notes.md = "where we left off" (overwritten each wrap),
# history.md = append-only session log. Redundant with the .claude/ rule above,
# kept explicit so the intent survives if that rule is ever narrowed.
.claude/notes.md
.claude/history.md
.claude/notes.archive.md

# Scratch space for large, untracked working files (logs, exports, dumps,
# anything pulled in for temporary analysis). The folder + its README marker
# are tracked so it exists on clone; nothing else inside is committed. If a
# file should be versioned, it does not belong in _files/.
_files/*
!_files/README.md
